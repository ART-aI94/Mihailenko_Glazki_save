<Window x:Class="Mihailenko_Glazki_save.PriorChange"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mihailenko_Glazki_save"
        mc:Ignorable="d"
        Title="PriorChange" Height="450" Width="800">
    <Grid>
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="10">
                <Label Content="Приоритет" Width="120" FontSize="20" ></Label>
                <TextBlock Text="" Name="TBPriority" FontSize="20" Width="200" VerticalAlignment="Center"></TextBlock>
            </StackPanel>
            <Button Name="ChangePrior" Content="Изменять приоритет" FontSize="20" Width="200" HorizontalAlignment="Left" Click="ChangePrior_Click"></Button>
        </StackPanel>
    </Grid>
</Window>
